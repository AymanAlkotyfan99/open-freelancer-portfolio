# Runtime mode — REQUIRED IN PRODUCTION
ENVIRONMENT=development
APP_NAME=Ayman Naeem Portfolio API
LOG_LEVEL=info

# Database — DATABASE_URL is REQUIRED IN PRODUCTION; pool values are OPTIONAL IN PRODUCTION
DATABASE_URL=postgresql+asyncpg://portfolio:portfolio@localhost:5432/portfolio
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE_SECONDS=1800

# Public origins — REQUIRED IN PRODUCTION
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,test,testserver
# Set true only behind Railway or another proxy that overwrites X-Real-IP.
TRUST_PROXY_HEADERS=false

# Authentication — JWT_SECRET_KEY is a SERVER SECRET and REQUIRED IN PRODUCTION
JWT_SECRET_KEY=<generate-a-long-random-secret-at-least-32-characters>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SAMESITE=lax
# Usually leave blank for host-only cookies. Set only for a deliberate shared custom-domain policy.
COOKIE_DOMAIN=

# Media — all Cloudinary values are SERVER SECRETS/identifiers and REQUIRED IN PRODUCTION
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=200
MAX_REQUEST_ATTACHMENT_MB=10
# DEVELOPMENT ONLY; production never serves this directory.
LOCAL_MEDIA_DIR=uploads

# Turnstile — SERVER SECRET and REQUIRED IN PRODUCTION
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost

# Email — OPTIONAL IN PRODUCTION, but required for transactional notifications
RESEND_API_KEY=
EMAIL_FROM=Portfolio <portfolio@example.com>
EMAIL_TO=

# GitHub — OPTIONAL IN PRODUCTION; token is a SERVER SECRET
GITHUB_USERNAME=
GITHUB_TOKEN=

# In-memory limiter guard — OPTIONAL IN PRODUCTION
RATE_LIMIT_MAX_KEYS=20000
