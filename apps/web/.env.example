# Build/runtime mode — REQUIRED IN PRODUCTION
APP_ENVIRONMENT=development

# PUBLIC FRONTEND values — all are REQUIRED IN PRODUCTION
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# PUBLIC FRONTEND and OPTIONAL IN PRODUCTION
NEXT_PUBLIC_GITHUB_USERNAME=

# Server/build behavior — OPTIONAL IN PRODUCTION; 0 disables caching
CONTENT_REVALIDATE_SECONDS=60
