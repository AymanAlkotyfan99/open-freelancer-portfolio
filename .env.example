# Local Docker Compose settings (development only)
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=<choose-a-local-development-password>

# Backend — see apps/api/.env.example for classifications and all optional tuning
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://portfolio:<local-password>@db:5432/portfolio
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:8000
TRUSTED_HOSTS=localhost,127.0.0.1,test,testserver,api
TRUST_PROXY_HEADERS=false
JWT_SECRET_KEY=<generate-a-long-random-secret-at-least-32-characters>
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_IMAGE_UPLOAD_MB=15
MAX_VIDEO_UPLOAD_MB=200
MAX_REQUEST_ATTACHMENT_MB=10
RESEND_API_KEY=
EMAIL_FROM=portfolio@example.com
EMAIL_TO=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=localhost,127.0.0.1
GITHUB_TOKEN=
GITHUB_USERNAME=

# Frontend — PUBLIC FRONTEND values must never contain server secrets
APP_ENVIRONMENT=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GITHUB_USERNAME=
CONTENT_REVALIDATE_SECONDS=60
